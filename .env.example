SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1
SCHWAB_TOKEN_PATH=tokens.json

# AI Debate tab (dashboard/ai_debate.py) -- get a key at console.anthropic.com.
# Pay-as-you-go, separate from any Claude subscription. Leave blank to disable
# the tab. Each fresh debate (bull + bear + PM) costs well under a cent with
# the default models; repeat questions on a ticker reuse the day's cached
# debate instead of re-running it.
ANTHROPIC_API_KEY=

# Push notifications (protective-order fills) via ntfy.sh. Pick a long, random
# topic name -- anyone who knows it can read your notifications. Leave blank
# to disable.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Only needed to run politicians/refresh.py (re-scraping new filings), not to
# read the dashboard's Politicians tab. SEC's EDGAR/company-tickers endpoint
# requires a contact email in every request's User-Agent -- use your own.
SEC_CONTACT_EMAIL=
